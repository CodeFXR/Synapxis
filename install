#!/bin/bash

# Stop execution immediately if any command fails (Safety first)
set -e

# ==============================================================================
# SYNAPXIS INSTALLER
# ==============================================================================

# --- Configuration ---
REPO_URL="https://github.com/CodeFXR/Synapxis.git"
INSTALL_DIR="$HOME/.synapxis"

# --- Visual Styling ---
ORANGE='\033[0;33m'
BOLD='\033[1m'
NC='\033[0m' # No Color

# Header
clear
echo -e "${ORANGE}${BOLD}"
echo "███████╗██╗   ██╗███╗   ██╗ █████╗ ██████╗ ██╗  ██╗██╗███████╗"
echo "██╔════╝╚██╗ ██╔╝████╗  ██║██╔══██╗██╔══██╗╚██╗██╔╝██║██╔════╝"
echo "███████╗ ╚████╔╝ ██╔██╗ ██║███████║██████╔╝ ╚███╔╝ ██║███████╗"
echo "╚════██║  ╚██╔╝  ██║╚██╗██║██╔══██║██╔═══╝  ██╔██╗ ██║╚════██║"
echo "███████║   ██║   ██║ ╚████║██║  ██║██║     ██╔╝ ██╗██║███████║"
echo "╚══════╝   ╚═╝   ╚═╝  ╚═══╝╚═╝  ╚═╝╚═╝     ╚═╝  ╚═╝╚═╝╚══════╝"
echo -e "${NC}"

# Spinner Animation
spinner() {
    local pid=$1
    local delay=0.1
    local spinstr='|/-\'
    while kill -0 "$pid" 2>/dev/null; do
        local temp=${spinstr#?}
        printf " [%c]  " "$spinstr"
        local spinstr=$temp${spinstr%"$temp"}
        sleep $delay
        printf "\b\b\b\b\b\b"
    done
    printf "    \b\b\b\b"
}

# ------------------------------------------------------------------------------
# STEP 1: Pre-flight Checks
# ------------------------------------------------------------------------------
echo -e "${BOLD}:: Checking Prerequisites...${NC}"

if ! command -v git &> /dev/null; then
    echo -e "   [!] Error: Git is not installed."
    exit 1
fi

if ! command -v python3 &> /dev/null; then
    echo -e "   [!] Error: Python 3 is not installed."
    exit 1
fi

echo -e "   [OK] System tools ready."
echo ""

# ------------------------------------------------------------------------------
# STEP 2: Download
# ------------------------------------------------------------------------------
echo -e "${BOLD}:: Downloading Synapxis...${NC}"

if [ -d "$INSTALL_DIR" ]; then
    echo -e "   [>] Removing previous installation..."
    rm -rf "$INSTALL_DIR"
fi

echo -n "   [>] Cloning repository..."
git clone --quiet --depth 1 "$REPO_URL" "$INSTALL_DIR" > /dev/null 2>&1 &
spinner $!
echo -e " Done"

cd "$INSTALL_DIR"

# ------------------------------------------------------------------------------
# STEP 3: Sandbox Setup
# ------------------------------------------------------------------------------
echo ""
echo -e "${BOLD}:: Setting up Virtual Environment...${NC}"

echo -n "   [>] Creating isolated Python sandbox..."
python3 -m venv .venv &
spinner $!
echo -e " Done"

source .venv/bin/activate

echo -n "   [>] Installing Python dependencies..."
# Explicitly installing dependencies here to ensure consistency across distros
pip install --upgrade pip > /dev/null 2>&1
pip install textual networkx scipy numpy textual-image maturin > /dev/null 2>&1 &
spinner $!
echo -e " Done"

echo ""

# ------------------------------------------------------------------------------
# STEP 4: Rust Compilation (Optional)
# ------------------------------------------------------------------------------
echo -e "${BOLD}:: Graphics Engine Setup...${NC}"

# Temporarily disable crash-on-error for the Rust build section
set +e 

if command -v cargo &> /dev/null; then
    echo -n "   [>] Rust detected. Compiling HD Braille Engine..."
    
    if [ -d "synapxis_rs" ]; then
        cd synapxis_rs
        if maturin develop --release > ../build.log 2>&1; then
            echo -e " Success (HD Mode Active)"
            cargo clean > /dev/null 2>&1
        else
            echo -e " Failed"
            echo -e "       (See build.log. Falling back to Standard Mode)"
        fi
        cd ..
    else
        echo -e " Skipped (Rust source folder not found)"
    fi
else
    echo -e "   [!] Rust/Cargo not found. Using Standard Mode."
fi

# Re-enable strict error checking
set -e
echo ""

# ------------------------------------------------------------------------------
# STEP 5: Shell Integration
# ------------------------------------------------------------------------------
echo -e "${BOLD}:: Finalizing...${NC}"

SHELL_CONFIG=""
case "$SHELL" in
  */zsh)
    SHELL_CONFIG="$HOME/.zshrc"
    ;;
  */bash)
    if [ -f "$HOME/.bash_profile" ]; then
        SHELL_CONFIG="$HOME/.bash_profile"
    else
        SHELL_CONFIG="$HOME/.bashrc"
    fi
    ;;
  *)
    SHELL_CONFIG="$HOME/.profile"
    ;;
esac

if [ -f "$SHELL_CONFIG" ]; then
    cp "$SHELL_CONFIG" "${SHELL_CONFIG}.bak"

    # Clean remove old aliases
    grep -v "alias synapxis=" "$SHELL_CONFIG" > "${SHELL_CONFIG}.tmp"
    grep -v "alias snx=" "${SHELL_CONFIG}.tmp" > "${SHELL_CONFIG}.tmp2" 
    mv "${SHELL_CONFIG}.tmp2" "$SHELL_CONFIG"
    rm "${SHELL_CONFIG}.tmp"

    # Add new aliases
    echo "" >> "$SHELL_CONFIG"
    echo "# Synapxis App" >> "$SHELL_CONFIG"
    echo "alias synapxis=\"$INSTALL_DIR/.venv/bin/python $INSTALL_DIR/synapxis.py\"" >> "$SHELL_CONFIG"
    echo "alias snx=\"$INSTALL_DIR/.venv/bin/python $INSTALL_DIR/synapxis.py\"" >> "$SHELL_CONFIG"

    echo -e "   [OK] Aliases added to ${ORANGE}$SHELL_CONFIG${NC}"
else
    echo -e "   [!] Could not detect shell config file."
    echo "       Add this manually to your config:"
    echo "       alias snx=\"$INSTALL_DIR/.venv/bin/python $INSTALL_DIR/synapxis.py\""
fi

# ------------------------------------------------------------------------------
# STEP 6: Completion
# ------------------------------------------------------------------------------
echo ""
echo -e "${ORANGE}===================================================${NC}"
echo -e "${BOLD}         INSTALLATION COMPLETE${NC}"
echo -e "${ORANGE}===================================================${NC}"
echo ""
echo -e "1. Restart your terminal, OR run: ${BOLD}source $SHELL_CONFIG${NC}"
echo -e "2. Launch with: ${BOLD}${ORANGE}snx${NC}"
echo ""
